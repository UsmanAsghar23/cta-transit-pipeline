# Copy to .env and fill in. Used by scripts/ and dbt (Airflow has its own airflow/.env).
# Load into your shell before running dbt:  set -a; source .env; set +a
CTA_BUS_API_KEY=
CTA_TRAIN_API_KEY=

# Snowflake (dbt dev target and scripts/export_mart.py)
SNOWFLAKE_ACCOUNT=<orgname>-<accountname>
SNOWFLAKE_USER=CTA_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/airflow/include/keys/cta_svc_key.p8
