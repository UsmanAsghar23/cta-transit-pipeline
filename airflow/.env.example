# Copy to airflow/.env (gitignored). Astro loads it into every Airflow container.
# Values are read literally: no quotes, keep JSON on one line.

# CTA API keys
CTA_BUS_API_KEY=
CTA_TRAIN_API_KEY=

# From `terraform output` (bucket_name)
CTA_S3_BUCKET=

# From `terraform output airflow_access_key_id` and `terraform output -raw airflow_secret_access_key`
AIRFLOW_CONN_AWS_DEFAULT={"conn_type":"aws","login":"<access_key_id>","password":"<secret_access_key>","extra":{"region_name":"us-east-2"}}

# Optional: Slack incoming webhook for freshness alerts. Leave blank to log only.
SLACK_WEBHOOK_URL=

# Snowflake service user with key-pair auth. account = <orgname>-<accountname>
# (Snowsight: bottom-left account menu > Connect a tool to Snowflake > Account identifier).
# The key path is inside the container; include/ is mounted from airflow/include/.
AIRFLOW_CONN_SNOWFLAKE_DEFAULT={"conn_type":"snowflake","login":"CTA_SVC","schema":"RAW","extra":{"account":"<orgname>-<accountname>","warehouse":"CTA_WH","database":"CTA","role":"CTA_ROLE","authenticator":"SNOWFLAKE_JWT","private_key_file":"/usr/local/airflow/include/keys/cta_svc_key.p8"}}
